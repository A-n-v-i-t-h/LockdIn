# Copy to .env.local for local development. Every value here is optional locally.

# Database. Leave empty to use the built-in local Postgres (PGlite) stored in .data/pglite.
# In production this is the Supabase pooler connection string (transaction mode, port 6543):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Where the local PGlite database lives when DATABASE_URL is empty.
PGLITE_DIR=.data/pglite

# Signs the login session cookie. At least 32 random characters. Required in production.
SESSION_SECRET=

# Protects the morning cron endpoint. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional. Pretend "now" is this instant (ISO 8601). Used by tests and demos only; ignored in production.
LOCKDIN_FAKE_NOW=
